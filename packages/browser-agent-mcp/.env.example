# Bind address / port (localhost only; Tailscale Funnel is the public edge)
HOST=127.0.0.1
PORT=8787

# Allowlisted workspace root for all file/shell tools
WORKSPACE_ROOT=/home/YOU/Documents/GitHub

# Bearer token required on every MCP request
# Prefer: andro-agent init  (writes ~/.config/browser-agent-mcp/token + env)
MCP_AUTH_TOKEN=

# Comma-separated Host headers allowed (DNS rebinding protection)
# Include localhost plus your Tailscale Funnel MagicDNS name
ALLOWED_HOSTS=127.0.0.1,localhost,YOUR-MACHINE.tailXXXX.ts.net

# Public URLs (Funnel). andro-agent init fills these from MagicDNS.
PUBLIC_BASE_URL=https://YOUR-MACHINE.tailXXXX.ts.net/agent
PUBLIC_MCP_URL=https://YOUR-MACHINE.tailXXXX.ts.net/agent/mcp

# Bash tool hard timeout in milliseconds
BASH_TIMEOUT_MS=30000
